{
  "permissions": {
    "allow": [
      "Bash(scripts/fases-ativas.sh:*)",
      "Bash(scripts/abrir-fase.sh:*)",
      "Bash(scripts/enfileirar.sh:*)",
      "Bash(scripts/integrar-fase.sh:*)",
      "Bash(scripts/fechar-pr.sh:*)",
      "Bash(scripts/conferir-fecho.sh:*)",
      "Bash(scripts/canal-avisar.sh:*)",
      "Bash(bash scripts/validar.sh)",
      "Bash(bash .claude/hooks/block-dangerous-git.test.sh)",
      "Bash(bash .claude/hooks/block-comandos-do-dono.test.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run:*)"
    ],
    "deny": [
      "Bash(gh pr merge --admin*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-comandos-do-dono.sh"
          }
        ]
      }
    ]
  }
}
